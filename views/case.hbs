<div class="progress" id="progress" aria-hidden="true"></div>

<article>
    <header class="measure case-head">
        <p class="eyebrow" data-reveal>
            <a class="link" href="/work" style="color:inherit">Work</a> — {{project.year}}
        </p>
        <h1 data-reveal style="--i:1">{{project.name}}</h1>
        <p class="lede" data-reveal style="--i:2">{{project.lede}}</p>

        <dl class="case-facts" data-reveal style="--i:3">
            <div>
                <dt>Role</dt>
                <dd>{{project.role}}</dd>
            </div>
            <div>
                <dt>Year</dt>
                <dd>{{project.year}}</dd>
            </div>
            <div>
                <dt>Built with</dt>
                <dd>{{join project.stack ", "}}</dd>
            </div>
        </dl>
    </header>

    <div class="measure case-body">
        {{#each project.sections}}
        <section data-reveal>
            <h2>{{this.heading}}</h2>
            <div>
                {{#each this.body}}
                <p>{{this}}</p>
                {{/each}}
            </div>
        </section>
        {{/each}}
    </div>

    <div class="measure case-foot">
        <span class="num">{{project.name}} · {{project.year}}</span>
        <a class="link link-out" href="{{project.link.href}}" target="_blank" rel="noopener noreferrer">
            {{project.link.label}}<span class="visually-hidden"> (opens in a new tab)</span>
        </a>
    </div>
</article>

<nav class="measure case-nav" aria-label="More work">
    <a href="/work/{{prev.slug}}">
        <span class="eyebrow">Previous</span>
        <span>{{prev.name}}</span>
    </a>
    <a href="/work/{{next.slug}}">
        <span class="eyebrow">Next</span>
        <span>{{next.name}}</span>
    </a>
</nav>
