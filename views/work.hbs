<header class="rail band--tight" style="padding-top:0">
    <p class="eyebrow" data-reveal>Work</p>
    <h1 data-reveal style="--i:1; max-width:16ch">Six things I'd walk you through in person.</h1>
    <p class="lede" data-reveal style="--i:2; max-width:34rem; margin-top:1.25rem">
        Each one had a real user. I can talk about the trade-offs, not just the
        stack — including the parts I got wrong.
    </p>
</header>

<section class="rail" style="padding-bottom:clamp(4rem,10vw,7rem)">
    <div class="index">
        {{#each projects}}
        {{> index-item project=this index=@index}}
        {{/each}}
    </div>
</section>
