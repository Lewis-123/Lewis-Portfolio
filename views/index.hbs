<section class="rail opening">
    <div class="opening-grid">
        <div>
            <h1 data-reveal>Lewis Mucheru</h1>

            <p class="role" data-reveal style="--i:1">
                Software Developer <span aria-hidden="true">|</span> AI &amp; Machine Learning Developer
            </p>

            <p class="lede" data-reveal style="--i:2">
                I build intelligent, scalable software solutions using
                Full-Stack Development, Artificial Intelligence,
                Machine Learning, Data Science, and Mobile Technologies.
            </p>

            <div class="actions" data-reveal style="--i:3">
                <a class="btn" href="/projects">View Projects</a>
                <a class="btn btn-quiet" href="/contact">Contact Me</a>
                <a class="btn btn-quiet" href="/files/Lewis-Mucheru-Resume.pdf" download>Download Resume</a>
            </div>
        </div>

        <figure class="portrait" data-reveal style="--i:2">
            <img src="/images/profile.jpg" alt="Lewis Mucheru" width="640" height="800">
        </figure>
    </div>
</section>

<section class="rail band" aria-labelledby="projects-heading">
    <div class="section-head" data-reveal>
        <h2 class="eyebrow" id="projects-heading">My Projects</h2>
    </div>

    <div class="index">
        {{#each projects}}
        {{> index-item project=this index=@index}}
        {{/each}}
    </div>
</section>

<section class="measure band--tight" aria-labelledby="technologies-heading">
    <h2 class="eyebrow" id="technologies-heading" data-reveal>Technologies I Work With</h2>
    <p class="lede" data-reveal style="--i:1">
        Technologies and tools I use to build modern, scalable software
        applications, intelligent systems, and data-driven solutions.
    </p>
</section>

<section class="rail" style="padding-bottom:clamp(3rem,7vw,4.5rem)">
    <ul class="tech-list" data-reveal>
        {{#each technologies}}
        <li>{{this}}</li>
        {{/each}}
    </ul>
</section>

<section class="measure band--tight" style="padding-bottom:clamp(4rem,10vw,7rem)">
    <div data-reveal>
        <h2 style="margin-bottom:1rem">Let’s Build Something Innovative</h2>
        <p class="lede" style="margin-bottom:1.75rem">
            I am open to software development opportunities, AI projects,
            collaborations, and technology-driven solutions.
        </p>
        <div class="actions">
            <a class="btn" href="https://www.linkedin.com/in/lewis-mucheru-6468b7228/" target="_blank" rel="noopener noreferrer">
                LinkedIn<span class="visually-hidden"> (opens in a new tab)</span>
            </a>
            <a class="btn btn-quiet" href="https://github.com/Lewis-123" target="_blank" rel="noopener noreferrer">
                GitHub<span class="visually-hidden"> (opens in a new tab)</span>
            </a>
            <a class="btn btn-quiet" href="mailto:mucherulewis@gmail.com">Email Me</a>
        </div>
    </div>
</section>
