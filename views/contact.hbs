<header class="measure band--tight" style="padding-top:0">
    <p class="eyebrow" data-reveal>Contact</p>
    <h1 data-reveal style="--i:1">If you're still here, write to me.</h1>
    <p class="lede" data-reveal style="--i:2; margin-top:1.25rem">
        I read every note. Roles, collaborations, or "I just liked the site" —
        all fine. I'm in Nairobi, so give me a few hours if our clocks disagree.
    </p>
</header>

<section class="measure" data-reveal style="--i:3">
    <div class="contact-rows">
        <button class="contact-row" type="button" data-copy="mucherulewis@gmail.com">
            <span>
                <span class="eyebrow">Email</span>
                <span class="contact-value">mucherulewis@gmail.com</span>
            </span>
            <span class="contact-action" data-copy-label>Copy</span>
        </button>

        <button class="contact-row" type="button" data-copy="+254114633746">
            <span>
                <span class="eyebrow">Phone</span>
                <span class="contact-value">+254 114 633746</span>
            </span>
            <span class="contact-action" data-copy-label>Copy</span>
        </button>

        <a class="contact-row" href="https://www.linkedin.com/in/lewis-mucheru-6468b7228/" target="_blank" rel="noopener noreferrer">
            <span>
                <span class="eyebrow">LinkedIn</span>
                <span class="contact-value">lewis-mucheru</span>
            </span>
            <span class="contact-action">Open ↗<span class="visually-hidden"> (opens in a new tab)</span></span>
        </a>

        <a class="contact-row" href="https://github.com/Lewis-123" target="_blank" rel="noopener noreferrer">
            <span>
                <span class="eyebrow">GitHub</span>
                <span class="contact-value">Lewis-123</span>
            </span>
            <span class="contact-action">Open ↗<span class="visually-hidden"> (opens in a new tab)</span></span>
        </a>
    </div>
</section>

<section class="measure" style="padding-bottom:clamp(4rem,10vw,7rem)">
    <form class="form" id="contact-form" data-reveal>
        <div class="field">
            <label for="name">Your name</label>
            <input id="name" name="name" type="text" autocomplete="name" required>
        </div>
        <div class="field">
            <label for="email">Your email</label>
            <input id="email" name="email" type="email" autocomplete="email" spellcheck="false" placeholder="name@example.com" required>
        </div>
        <div class="field">
            <label for="message">What you wanted to say</label>
            <textarea id="message" name="message" rows="6" required></textarea>
        </div>
        <button class="btn" type="submit">Open email</button>
        <p class="form-note">This opens your email app with the message ready. No black hole.</p>
    </form>
</section>
