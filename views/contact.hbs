<header class="measure band--tight" style="padding-top:0">
    <h1 data-reveal>Contact Me</h1>
    <p class="lede" data-reveal style="--i:1; margin-top:1.25rem">
        I am open to software development opportunities,
        collaborations, and technology projects involving
        full-stack development, artificial intelligence,
        machine learning, and data science.
    </p>
</header>

<section class="measure" data-reveal style="--i:2" aria-labelledby="get-in-touch">
    <h2 class="eyebrow" id="get-in-touch">Get In Touch</h2>
    <div class="contact-rows">
        <p class="contact-row contact-row--static">
            <span>
                <span class="eyebrow">Name:</span>
                <span class="contact-value">Lewis Mucheru</span>
            </span>
        </p>

        <button class="contact-row" type="button" data-copy="mucherulewis@gmail.com">
            <span>
                <span class="eyebrow">Email:</span>
                <span class="contact-value">mucherulewis@gmail.com</span>
            </span>
            <span class="contact-action" data-copy-label>Copy</span>
        </button>

        <button class="contact-row" type="button" data-copy="+254114633746">
            <span>
                <span class="eyebrow">Phone:</span>
                <span class="contact-value">+254 114 633746</span>
            </span>
            <span class="contact-action" data-copy-label>Copy</span>
        </button>

        <p class="contact-row contact-row--static">
            <span>
                <span class="eyebrow">Location:</span>
                <span class="contact-value">Nairobi, Kenya</span>
            </span>
        </p>
    </div>
</section>

<section class="measure band--tight" data-reveal aria-labelledby="profiles">
    <h2 class="eyebrow" id="profiles">Online Profiles</h2>
    <div class="contact-rows">
        <a class="contact-row" href="https://github.com/Lewis-123" target="_blank" rel="noopener noreferrer">
            <span class="contact-value">GitHub</span>
            <span class="contact-action">Open ↗<span class="visually-hidden"> (opens in a new tab)</span></span>
        </a>
        <a class="contact-row" href="https://www.linkedin.com/in/lewis-mucheru-6468b7228/" target="_blank" rel="noopener noreferrer">
            <span class="contact-value">LinkedIn</span>
            <span class="contact-action">Open ↗<span class="visually-hidden"> (opens in a new tab)</span></span>
        </a>
    </div>
</section>

<section class="measure" style="padding-bottom:clamp(4rem,10vw,7rem)" aria-labelledby="send-a-message">
    <h2 class="eyebrow" id="send-a-message" data-reveal>Send a Message</h2>
    <form class="form" id="contact-form" data-reveal style="margin-top:1.5rem">
        <div class="field">
            <label for="name">Your Name</label>
            <input id="name" name="name" type="text" autocomplete="name" required>
        </div>
        <div class="field">
            <label for="email">Your Email</label>
            <input id="email" name="email" type="email" autocomplete="email" spellcheck="false" required>
        </div>
        <div class="field">
            <label for="message">Your Message</label>
            <textarea id="message" name="message" rows="6" required></textarea>
        </div>
        <button class="btn" type="submit">Send Message</button>
    </form>
</section>
