<a class="index-item" href="/projects/{{project.slug}}" data-reveal style="--i:{{index}}">
    <span class="index-num">{{pad index}}</span>
    <span class="index-name">{{project.name}}</span>
    <span class="index-meta">
        {{#if project.badge}}<span class="badge">{{project.badge}}</span>{{/if}}
        <span class="index-arrow" aria-hidden="true">&rarr;</span>
    </span>
    <span class="index-summary">{{project.subtitle}}</span>
    <span class="index-stack">{{join project.tech " · "}}</span>
</a>
