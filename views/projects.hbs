<header class="measure band--tight" style="padding-top:0">
    <h1 data-reveal>My Projects</h1>
    <p class="lede" data-reveal style="--i:1; margin-top:1.25rem">
        A collection of software applications demonstrating my experience
        in full-stack development, artificial intelligence, machine learning,
        mobile development, and data-driven solutions.
    </p>
</header>

<section class="rail" style="padding-bottom:clamp(4rem,10vw,7rem)">
    <div class="index">
        {{#each projects}}
        {{> index-item project=this index=@index}}
        {{/each}}
    </div>
</section>
